# شبیه‌سازی منطق فیلتر پوزیشن باز
def test_signal_filter():
    signals = [
        {"symbol": "BTCUSDT", "price": 79032, "tp": 80217, "sl": 78083},
        {"symbol": "BTCUSDT", "price": 78992, "tp": 80176, "sl": 78044},
        {"symbol": "BTCUSDT", "price": 79080, "tp": 80266, "sl": 78131},
    ]
    
    active_positions = {}
    
    print("--- تست منطق جلوگیری از سیگنال تکراری ---")
    for sig in signals:
        sym = sig["symbol"]
        
        if sym in active_positions:
            print(f"[فیلتر شد ❌] ارز {sym} پوزیشن باز دارد. سیگنال جدید نادیده گرفته شد.")
            continue
            
        active_positions[sym] = sig
        print(f"[سیگنال تایید شد ✅] برای {sym} در قیمت {sig['price']} پوزیشن باز شد.")

if __name__ == "__main__":
    test_signal_filter()

